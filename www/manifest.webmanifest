{
  "id": "/",
  "name": "DOSHIE – Private Family Assistant",
  "short_name": "DOSHIE",
  "description": "Hermes's private, family-first AI assistant.",
  "start_url": "/",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#181a19",
  "theme_color": "#5c8f73",
  "categories": ["productivity", "utilities", "lifestyle"],
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Mansion DOSHIE",
      "short_name": "Mansion",
      "description": "Open DOSHIE's dedicated build room.",
      "url": "/mansion",
      "icons": [{"src": "/static/DOSHIE-192.png", "sizes": "192x192"}]
    },
    {
      "name": "DOSHIE Search Hub",
      "short_name": "Search",
      "description": "Search the web or approved TECRA folders.",
      "url": "/search",
      "icons": [{"src": "/static/DOSHIE-192.png", "sizes": "192x192"}]
    },
    {
      "name": "DOSHIE Watch Mode",
      "short_name": "Watch",
      "description": "Open the compact watch assistant.",
      "url": "/watch",
      "icons": [{"src": "/static/DOSHIE-192.png", "sizes": "192x192"}]
    }
  ],
  "icons": [
    {
      "src": "/static/DOSHIE-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/DOSHIE-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/DOSHIE-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "prefer_related_applications": false
}
