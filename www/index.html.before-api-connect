<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Doshie // Companion Workspace</title>
<style>
:root{--bg:#090506;--panel:#12090b;--panel2:#190c10;--line:#4a1820;--text:#fff7f8;--muted:#b99da2;--cyan:#ff334f;--green:#78f0ae;--purple:#ff6a7e;--danger:#ff718f;--radius:18px}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--bg);color:var(--text);font:14px system-ui,sans-serif}
button,input,textarea,select{font:inherit}button{cursor:pointer;color:inherit}button,input,textarea,select{border:1px solid var(--line);border-radius:12px;background:var(--panel2);color:var(--text)}
.shell{height:100dvh;display:grid;grid-template-columns:230px minmax(0,1fr) 280px;grid-template-rows:72px minmax(0,1fr) 78px}
.topbar{grid-column:1/-1;display:flex;align-items:center;gap:16px;padding:10px 22px;border-bottom:1px solid var(--line);background:#0d0708f5}
.brand{display:flex;align-items:center;gap:11px;font-weight:900;letter-spacing:.16em}.brand img{width:42px;height:42px;border:1px solid var(--cyan);border-radius:14px;object-fit:cover;box-shadow:0 0 22px #58e5ff55}.brand small{display:block;color:var(--muted);font-size:9px;letter-spacing:.12em;margin-top:3px}
.top-spacer{flex:1}.command-link{display:inline-flex;align-items:center;gap:5px;padding:8px 10px;border:1px solid var(--line);border-radius:10px;background:var(--panel2);color:var(--text);text-decoration:none;font-weight:700;white-space:nowrap}.command-link:hover{border-color:var(--cyan);color:var(--cyan)}.profile-switch{display:flex;align-items:center;gap:9px;padding:6px 10px;border-color:var(--line)}.profile-initial{display:grid;place-items:center;width:32px;height:32px;border-radius:11px;background:linear-gradient(135deg,var(--purple),var(--cyan));color:#07111f;font-weight:900}.online{color:var(--green);white-space:nowrap}.online i{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 12px var(--green)}
.sidebar{padding:18px 12px;border-right:1px solid var(--line);background:#0d0708;overflow:auto}.nav-title{margin:8px 10px;color:#6f859e;font-size:10px;letter-spacing:.18em;text-transform:uppercase}.nav{display:block;width:100%;margin:4px 0;padding:12px;text-align:left;border-color:transparent;background:transparent;color:#c1d0e0}.nav:hover,.nav.active{background:#271014;border-color:#7a202c;color:var(--cyan)}.card-mini{margin-top:22px;padding:13px;border:1px solid var(--line);border-radius:14px;background:var(--panel)}.card-mini small{color:var(--muted)}
.main{min-width:0;display:flex;flex-direction:column;background:radial-gradient(circle at 50% -20%,#441019 0,transparent 45%),var(--bg)}.page-head{padding:25px 32px 12px}.eyebrow{color:var(--cyan);font-size:10px;letter-spacing:.2em;text-transform:uppercase}.page-head h1{margin:7px 0 4px;font-size:30px}.buddy-heading{display:flex;align-items:center;gap:9px}.buddy-icon{position:relative;display:grid;place-items:center;width:34px;height:34px;flex:none;border:1px solid var(--cyan);border-radius:11px;background:var(--panel2);overflow:visible;animation:buddy-think 2.2s ease-in-out infinite;box-shadow:0 0 14px #ff334f44}.buddy-icon img{width:100%;height:100%;object-fit:cover;border-radius:10px}.thought-dots{position:absolute;top:-10px;right:-16px;display:flex;gap:2px;align-items:flex-end}.thought-dots i{display:block;width:4px;height:4px;border-radius:50%;background:var(--cyan);animation:dot-pop 1.2s ease-in-out infinite}.thought-dots i:nth-child(2){width:5px;height:5px;animation-delay:.16s}.thought-dots i:nth-child(3){width:7px;height:7px;animation-delay:.32s}@keyframes buddy-think{0%,100%{transform:translateY(0) rotate(-5deg)}50%{transform:translateY(-5px) rotate(5deg)}}@keyframes dot-pop{0%,100%{opacity:.35;transform:translateY(2px)}50%{opacity:1;transform:translateY(-2px)}}.page-head p{margin:0;color:var(--muted)}
.modebar{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}.modebar button{padding:8px 12px;color:var(--muted)}.modebar button.active{background:var(--cyan);border-color:var(--cyan);color:#06111d}
.messages{flex:1;min-height:0;overflow:auto;padding:12px 32px 26px}.empty{display:grid;place-items:center;min-height:220px;padding:25px;text-align:center;color:var(--muted)}.empty strong{display:block;color:var(--text);font-size:18px;margin-bottom:7px}.message{display:flex;gap:10px;max-width:760px;margin:15px 0}.message.me{margin-left:auto;flex-direction:row-reverse}.avatar{width:36px;height:36px;flex:none;display:grid;place-items:center;border-radius:50%;background:linear-gradient(135deg,var(--purple),var(--cyan));color:#06111d;font-weight:900}.avatar img{width:100%;height:100%;border-radius:50%;object-fit:cover}.bubble{padding:13px 15px;border:1px solid var(--line);border-radius:5px 16px 16px 16px;background:var(--panel2);line-height:1.5}.me .bubble{border-radius:16px 5px 16px 16px;border-color:#33618e}.bubble strong{display:block;color:var(--cyan);font-size:12px;margin-bottom:4px}.bubble p{margin:0;white-space:pre-wrap;overflow-wrap:anywhere}
.composer{display:grid;grid-template-columns:46px 46px 46px minmax(0,1fr) 52px;gap:8px;padding:12px 32px 20px;border-top:1px solid var(--line);background:#0d0708}.composer button{display:grid;place-items:center;min-height:46px}.composer input{min-width:0;padding:12px 14px}.composer .send{background:var(--cyan);color:#06111d;font-size:20px}.composer .mic.live{background:var(--danger);color:#fff}
.rightbar{padding:18px 14px;border-left:1px solid var(--line);background:#0d0708;overflow:auto}.panel{padding:15px;margin-bottom:12px;border:1px solid var(--line);border-radius:var(--radius);background:var(--panel)}.panel h3{margin:0 0 6px;font-size:14px}.panel p{margin:5px 0 13px;color:var(--muted);line-height:1.45;font-size:12px}.panel button{width:100%;padding:10px;margin-top:7px}.status-row{display:flex;align-items:center;gap:8px;margin:9px 0;color:var(--muted);font-size:12px}.status-row i{width:7px;height:7px;border-radius:50%;background:var(--green)}.tool-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.tool-grid button{margin:0}.tool-grid button:first-child{border-color:var(--cyan);color:var(--cyan)}
.download-card{margin-top:10px;padding:12px;border:1px solid var(--line);border-radius:14px;background:var(--panel2)}.download-card h4{margin:0 0 5px;font-size:13px}.download-card p{margin:0 0 10px;color:var(--muted);font-size:11px;line-height:1.4}.download-link{display:block;width:100%;padding:10px 11px;border:1px solid var(--cyan);border-radius:10px;background:#1d0b10;color:var(--text);text-align:center;text-decoration:none;font-weight:700}.download-link:hover{background:var(--cyan);color:#06111d}.download-link.secondary{margin-top:7px;border-color:var(--line);font-weight:600}
.bottom{grid-column:1/-1;display:flex;align-items:center;gap:12px;padding:10px 22px;border-top:1px solid var(--line);background:#0b0607;color:var(--muted)}.bottom small{flex:1}.bottom button{padding:9px 12px}
.drawer{display:none}
@media(max-width:900px){.shell{grid-template-columns:1fr;grid-template-rows:62px minmax(0,1fr) 70px}.sidebar,.rightbar{display:none}.topbar{padding:8px 13px}.page-head{padding:17px 16px 8px}.page-head h1{font-size:23px}.page-head p{font-size:12px}.messages{padding:8px 14px 20px}.composer{grid-template-columns:42px 42px 42px minmax(0,1fr) 46px;gap:6px;padding:9px 10px calc(10px + env(safe-area-inset-bottom))}.bottom{padding:8px 12px;font-size:11px}.bottom button{padding:8px}}
@media(max-width:560px){.topbar{gap:8px}.command-link{width:34px;padding:8px;justify-content:center;font-size:0}.command-link::before{content:"🛡️";font-size:16px}.brand small{display:none}.brand img{width:36px;height:36px}.brand{font-size:13px}.profile-switch{max-width:150px}.profile-switch select{max-width:100px;border:0;padding:4px}.online{font-size:0}.online i{margin-left:4px}.modebar{gap:5px;margin-top:11px}.modebar button{padding:7px 8px;font-size:11px}.messages{padding-bottom:12px}.bubble{padding:10px 11px}.composer input{font-size:14px}.bottom small{display:none}.bottom{justify-content:flex-end}}
</style>
</head>
<body>
<div class="shell">
<header class="topbar"><div class="brand"><img src="diyoshi-avatar.png" alt="Doshie"><div>DOSHIE<small>PRIVATE COMPANION WORKSPACE</small></div></div><div class="top-spacer"></div><a class="command-link" href="/control">🛡️ Command Center</a><label class="profile-switch"><span id="initial" class="profile-initial">H</span><select id="profiles" aria-label="Switch profile"><option value="Hermes">Hermes Duran</option></select></label><span class="online"><i></i> ONLINE</span></header>
<nav class="sidebar"><div class="nav-title">Workspace</div><button class="nav active" data-view="chat">⌂ Chat</button><button class="nav" data-view="hermes">✦ Hermes AI</button><button class="nav" data-view="terminal">⌁ Terminals</button><button class="nav" data-view="media">◈ Media Studio</button><button class="nav" data-view="memory">🧠 Memory</button><div class="nav-title">Manage</div><button class="nav" data-view="profiles">♙ Profiles</button><button class="nav" data-view="settings">⚙ Settings</button><a class="nav download-link" href="https://hermes-duran-tecra-a60-m.tail50b4c5.ts.net:8444/Doshie-latest.apk">⬇ Download Android app</a><div class="card-mini"><b>Doshie</b><br><small>Local companion · protected</small></div></nav>
<main class="main"><section class="page-head"><div class="eyebrow">Active channel / secure</div><div class="buddy-heading"><span class="buddy-icon" title="Doshie is thinking"><img src="diyoshi-avatar.png" alt=""><span class="thought-dots" aria-hidden="true"><i></i><i></i><i></i></span></span><h1 id="title">Talk to your AI</h1></div><p id="subtitle">Chat, code, build, and grow together.</p><div class="modebar"><button id="remembered" class="active">◷ Remembered</button><button id="incognito">◉ Incognito</button><button id="newchat">＋ New chat</button><span id="modeStatus">Loading chat…</span></div><div id="updateCard" class="download-card update-card" hidden><h4>✨ Doshie update available</h4><p id="updateText">A newer signed Android app is ready.</p><div class="update-actions"><a id="updateDownload" class="download-link" href="#">⬇ Download update</a><button id="updateLater" class="download-link secondary" type="button">Later</button></div></div></section><section id="messages" class="messages"></section><input id="filePicker" type="file" multiple accept="image/*,.pdf,.txt,.md,.csv,.json,.py,.js,.css,.html" hidden><input id="cameraPicker" type="file" accept="image/*" capture="environment" hidden><div class="composer"><button id="attach" title="Attach file">📎</button><button id="camera" title="Use camera">📷</button><button id="mic" title="Use microphone">●</button><input id="input" placeholder="Message Doshie…"><button id="send" class="send" title="Send">↑</button></div></main>
<aside class="rightbar"><section class="panel"><h3>Quick tools</h3><p>Keep the everyday controls together and open advanced tools only when needed.</p><div class="tool-grid"><button data-view="hermes">Hermes</button><button data-view="terminal">Terminal</button><button data-view="memory">Memory</button><button data-view="settings">Settings</button></div><div class="download-card"><h4>Get Doshie on Android</h4><p>Use this permanent link for the current signed APK. Tailscale must be connected.</p><a class="download-link" href="https://hermes-duran-tecra-a60-m.tail50b4c5.ts.net:8444/Doshie-latest.apk">⬇ Download latest APK</a><a class="download-link secondary" href="https://hermes-duran-tecra-a60-m.tail50b4c5.ts.net:8444/">Open download center</a></div></section><section class="panel"><h3>Doshie status</h3><div class="status-row"><i></i> Memory synchronized</div><div class="status-row"><i></i> Local-first routing</div><div class="status-row"><i></i> Companion ready</div></section></aside>
<footer class="bottom"><small>PRIVATE WORKSPACE · APPROVAL REQUIRED</small><button id="refresh">↻ Refresh</button><button id="fullscreen">⛶ Fullscreen</button></footer>
</div>
<script>
const $=s=>document.querySelector(s);let profile="Hermes",mode="remembered",media=[];
function applySavedCommandAppearance(){try{const saved=JSON.parse(localStorage.getItem("doshie_command_appearance")||"null");if(!saved)return;if(saved.accent)document.documentElement.style.setProperty("--cyan",saved.accent);if(saved.radius)document.documentElement.style.setProperty("--radius",saved.radius+"px");if(saved.font)document.body.style.fontFamily=saved.font;if(saved.size)document.body.style.fontSize=saved.size+"px"}catch(e){}}
applySavedCommandAppearance();
const updateSeenKey="doshie_seen_android_version";
function showAndroidUpdate(release){const card=$("#updateCard"),text=$("#updateText"),download=$("#updateDownload"),later=$("#updateLater");if(!card||!release)return;const version=String(release.version||"");text.textContent="Android app version "+version+" is ready to install.";download.href=new URL(String(release.url||"/"),window.location.origin).href;download.onclick=()=>localStorage.setItem(updateSeenKey,version);later.onclick=()=>{localStorage.setItem(updateSeenKey,version);card.hidden=true};card.hidden=false}
async function checkForAndroidUpdate(){try{const r=await fetch("/app-version?now="+Date.now(),{cache:"no-store"}),d=await r.json();if(!r.ok)return;const release=d.releases&&d.releases.android;if(!release||!release.version)return;const latest=String(release.version),seen=localStorage.getItem(updateSeenKey);if(!seen){localStorage.setItem(updateSeenKey,latest);return}if(latest!==seen)showAndroidUpdate(release)}catch(e){}}
function esc(v){const d=document.createElement("div");d.textContent=v??"";return d.innerHTML}
function empty(title,text){$("#messages").innerHTML='<div class="empty"><div><strong>'+esc(title)+'</strong>'+esc(text)+'</div></div>'}
function add(role,text){const row=document.createElement("article");row.className="message "+(role==="user"?"me":"");const av=document.createElement("div");av.className="avatar";av.textContent=role==="user"?($("#initial").textContent||"H"):"D";const b=document.createElement("div");b.className="bubble";b.innerHTML='<strong>'+esc(role==="user"?profile:"Doshie")+'</strong><p>'+esc(text)+'</p>';row.append(av,b);$("#messages").append(row)}
async function loadChat(){if(mode==="incognito"){empty("Incognito chat","Nothing in this chat will be saved.");$("#modeStatus").textContent="Incognito";return}try{const r=await fetch("/chat-history?profile="+encodeURIComponent(profile)+"&space=main",{cache:"no-store"}),d=await r.json();if(!r.ok)throw Error(d.error||"Chat unavailable");$("#messages").replaceChildren();(d.history||[]).forEach(x=>add(x.role,x.content));if(!d.history?.length)empty("Welcome to Doshie","Start a conversation. Remembered chats return here next time.");$("#modeStatus").textContent="Remembered · "+profile}catch(e){empty("Chat unavailable","Refresh the workspace and try again.");$("#modeStatus").textContent="Offline"}}
async function send(){const field=$("#input"),text=field.value.trim();if(!text)return;add("user",text);field.value="";$("#modeStatus").textContent="Doshie is thinking…";try{const r=await fetch("/chat",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({profile,space:"main",message:text,incognito:mode==="incognito"})}),d=await r.json();add("assistant",d.reply||d.response||d.error||"I could not answer right now.");$("#modeStatus").textContent=mode==="incognito"?"Incognito":"Remembered · "+profile}catch(e){add("assistant","The local assistant is temporarily unavailable.");$("#modeStatus").textContent="Connection unavailable"}$("#messages").scrollTop=$("#messages").scrollHeight}
function view(name){if(name==="control")location.href="/control";if(name==="terminal")location.href="/tech?view=terminal";if(name==="hermes")location.href="/tech?view=hermes";if(name==="media")location.href="/tech?view=media";if(name==="memory")location.href="/tech?view=memory";if(name==="profiles")location.href="/tech?view=profiles";if(name==="settings")location.href="/tech?view=settings"}
document.querySelectorAll("[data-view]").forEach(x=>x.onclick=()=>view(x.dataset.view));
$("#send").onclick=send;$("#input").addEventListener("keydown",e=>{if(e.key==="Enter"&&!e.shiftKey){e.preventDefault();send()}});
$("#remembered").onclick=()=>{mode="remembered";$("#remembered").classList.add("active");$("#incognito").classList.remove("active");loadChat()};
$("#incognito").onclick=()=>{mode="incognito";$("#incognito").classList.add("active");$("#remembered").classList.remove("active");loadChat()};
$("#newchat").onclick=()=>{mode="incognito";$("#incognito").click()};
$("#refresh").onclick=()=>location.reload();$("#fullscreen").onclick=()=>document.documentElement.requestFullscreen?.();
$("#profiles").onchange=e=>{profile=e.target.value;$("#initial").textContent=(profile.trim()[0]||"?").toUpperCase();loadChat()};
$("#attach").onclick=()=>alert("Choose a file from the attachment control in the full chat view.");
$("#camera").onclick=()=>alert("Camera is available from the full chat view.");
$("#mic").onclick=()=>{if(!("webkitSpeechRecognition" in window||"SpeechRecognition" in window)){alert("Speech recognition is not available in this browser.");return}const R=window.SpeechRecognition||window.webkitSpeechRecognition,r=new R;r.lang="en-US";r.onresult=e=>$("#input").value=e.results[0][0].transcript;r.start()};
loadChat();
checkForAndroidUpdate();
async function loadProfiles(){try{const r=await fetch("/profiles",{cache:"no-store"}),d=await r.json();const list=d.profiles||d||[];if(!Array.isArray(list))return;const select=$("#profiles");list.forEach(p=>{const name=typeof p==="string"?p:(p.name||p.profile);if(!name||[...select.options].some(o=>o.value===name))return;const o=document.createElement("option");o.value=name;o.textContent=name;select.append(o)})}catch(e){}}
$("#attach").onclick=()=>$("#filePicker").click();$("#camera").onclick=()=>$("#cameraPicker").click();$("#filePicker").onchange=e=>{media=[...e.target.files];$("#modeStatus").textContent=media.length+" file"+(media.length===1?"":"s")+" ready to send"};$("#cameraPicker").onchange=e=>{media=[...e.target.files];$("#modeStatus").textContent=media.length?"Photo ready to send":"Camera closed"};loadProfiles();
</script>
</body>
</html>
