<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_search_bar_root"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/widget_bar_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/widget_doshie_logo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/app_name"
        android:src="@mipmap/ic_launcher_round" />

    <TextView
        android:id="@+id/widget_search_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:singleLine="true"
        android:text="Ask Doshie..."
        android:textColor="#A7F3D0"
        android:textSize="15sp"
        android:textStyle="normal" />

    <ImageView
        android:id="@+id/widget_btn_music"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_button_background"
        android:contentDescription="Music Player"
        android:padding="8dp"
        android:src="@drawable/ic_widget_music" />

    <ImageView
        android:id="@+id/widget_btn_mic"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/widget_button_background"
        android:contentDescription="Live Voice Wake"
        android:padding="8dp"
        android:src="@drawable/ic_widget_mic" />

</LinearLayout>
